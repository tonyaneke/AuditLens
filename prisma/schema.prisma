generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SEC-03 — authentication is Microsoft Entra SSO only. `passwordHash` and `mustChangePassword`
// were removed: no local login route ever existed, verifyPassword had no call sites, and the hash
// column held an unusable random value for every user. Drop the columns with
// `npx tsx scripts/drop-local-password.mts --apply` AFTER this code is deployed everywhere —
// Prisma selects all scalar columns, so an instance still running the old code would 500 on every
// user lookup if the columns went first.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  // The person's home department — one value, so the Settings dropdown and every screen that
  // prints "Role · Department" stay simple.
  department    String
  // Departments they ALSO belong to. Since observations are department-scoped (lib/dept-scope.ts)
  // department is an access control, and a few people genuinely straddle two: the Head of Admin,
  // People & Culture, and the Chief of Staff who covers Strategic Comms alongside the MD's office.
  // Modelling that as a second home department would have meant choosing which half of their job
  // they could see. Both fields confer identical access.
  extraDepartments Json  @default("[]")
  role          String
  sidebarAccess Json     @default("[]")
  active        Boolean  @default(true) // false = deactivated: sign-in blocked, history kept
  photo         String?  // Microsoft profile picture as a data URL (fetched on SSO sign-in)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Stamped the first (and only) time the "your account is ready" email actually goes out.
  // Accounts provisioned ahead of go-live are created inactive and un-emailed — telling someone
  // their account is ready while sign-in is still blocked is worse than silence. The Head of
  // Audit making them active is what releases the email, and this column is what stops a later
  // deactivate/reactivate cycle from sending it a second time.
  welcomeEmailSentAt DateTime?

  adminCredential AdminCredential?
}

// The ONE exception to Microsoft-only sign-in (SEC-03): a password for the dedicated Admin
// profile, so it can be signed into without a Microsoft account of its own. Only an account whose
// role is "admin" can sign in with it, and never while ADMIN_LOGIN_ENABLED=false — see
// lib/admin-credential.ts. Seeded by scripts/seed-admin-profile.mts; never written by the app
// except to count failed attempts and stamp the last sign-in. The sign-in name is the account's
// own User.email — there is no separate username to drift from it.
model AdminCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash      String    // scrypt — the format is documented in lib/admin-credential.ts
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  // A session issued before this is void: rotating the password signs every existing session out.
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model WorkspaceData {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // The account the action was taken under. See actorName for when that is not who took it.
  userId    String?
  userName  String
  userEmail String
  action    String
  category  String
  summary   String
  metadata  Json?

  // Provenance — who was really at the keyboard, and how they got there. Added 2026-09-26 by
  // scripts/add-audit-provenance.mts; all nullable, so rows written before it simply have none.
  //
  // The role the action was taken under: "action_owner", "head_of_audit", … — or
  // "admin:<role>" for an admin, who acts as whichever view they switched to.
  userRole   String?
  // How the session was established: "sso" (Microsoft), "dev" (the developer sign-in),
  // "system" (a scheduled job) or "script" (a maintenance script run from a terminal).
  authMethod String?
  // Who operated the session when it was NOT the account holder: the developer behind a
  // developer sign-in, or whoever ran a script. Null means the account holder acted in person.
  actorName  String?
  // Minted at sign-in and carried in the session cookie, so every entry one sign-in wrote shares it.
  sessionId  String?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([category])
  @@index([sessionId])
  @@index([authMethod])
}

// Per-user form drafts (observation raise wizard, etc.) — server-side, not browser storage.
model UserDraft {
  id        String   @id @default(cuid())
  userId    String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}
