generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SEC-03 — authentication is Microsoft Entra SSO only. `passwordHash` and `mustChangePassword`
// were removed: no local login route ever existed, verifyPassword had no call sites, and the hash
// column held an unusable random value for every user. Drop the columns with
// `npx tsx scripts/drop-local-password.mts --apply` AFTER this code is deployed everywhere —
// Prisma selects all scalar columns, so an instance still running the old code would 500 on every
// user lookup if the columns went first.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  department    String
  role          String
  sidebarAccess Json     @default("[]")
  active        Boolean  @default(true) // false = deactivated: sign-in blocked, history kept
  photo         String?  // Microsoft profile picture as a data URL (fetched on SSO sign-in)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Stamped the first (and only) time the "your account is ready" email actually goes out.
  // Accounts provisioned ahead of go-live are created inactive and un-emailed — telling someone
  // their account is ready while sign-in is still blocked is worse than silence. The Head of
  // Audit making them active is what releases the email, and this column is what stops a later
  // deactivate/reactivate cycle from sending it a second time.
  welcomeEmailSentAt DateTime?
}

model WorkspaceData {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  userName  String
  userEmail String
  action    String
  category  String
  summary   String
  metadata  Json?

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([category])
}
